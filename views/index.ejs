<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Employee Management System</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<nav class="navbar navbar-expand-lg navbar-dark shadow">

    <div class="container">

        <a class="navbar-brand fw-bold" href="/">
            <i class="bi bi-buildings-fill"></i>
            EmployeeMS
        </a>

        <div>

            <a href="/add" class="btn btn-light me-2">
                <i class="bi bi-person-plus-fill"></i>
                Add Employee
            </a>

            <a href="/admin" class="btn btn-warning">
                <i class="bi bi-person-circle"></i>
                Admin
            </a>

        </div>

    </div>

</nav>

<div class="container mt-4">

    <div class="alert alert-primary shadow">

        <h3>
            Welcome Back, Administrator 👋
        </h3>

        <p class="mb-0">
            Manage your employees efficiently using Employee Management System.
        </p>

    </div>

    <div class="row g-4">

        <div class="col-lg-3 col-md-6">

            <div class="card text-center">

                <div class="card-body">

                    <i class="bi bi-people-fill text-primary display-5"></i>

                    <h5 class="mt-3">
                        Total Employees
                    </h5>

                    <h2>
                        <%= employees.length %>
                    </h2>

                </div>

            </div>

        </div>

        <div class="col-lg-3 col-md-6">

            <div class="card text-center">

                <div class="card-body">

                    <i class="bi bi-building text-success display-5"></i>

                    <h5 class="mt-3">
                        Departments
                    </h5>

                    <h2>8</h2>

                </div>

            </div>

        </div>

        <div class="col-lg-3 col-md-6">

            <div class="card text-center">

                <div class="card-body">

                    <i class="bi bi-cash-stack text-warning display-5"></i>

                    <h5 class="mt-3">
                        Average Salary
                    </h5>

                    <h2>₹50,000</h2>

                </div>

            </div>

        </div>

        <div class="col-lg-3 col-md-6">

            <div class="card text-center">

                <div class="card-body">

                    <i class="bi bi-person-check-fill text-danger display-5"></i>

                    <h5 class="mt-3">
                        Active Employees
                    </h5>

                    <h2>
                        <%= employees.length %>
                    </h2>

                </div>

            </div>

        </div>

    </div>

    <div class="row mt-5">

        <div class="col-md-12">

            <form action="/search" method="GET">

                <div class="input-group">

                    <input
                        type="text"
                        class="form-control"
                        placeholder="Search by Name, Department or Position"
                        name="keyword">

                    <button class="btn btn-primary">

                        <i class="bi bi-search"></i>

                    </button>

                </div>

            </form>

        </div>

    </div>

    <div class="card shadow mt-4">

        <div class="card-header bg-dark text-white">

            <h4 class="mb-0">

                Employee Directory

            </h4>

        </div>

        <div class="table-responsive">

            <table class="table table-hover table-striped align-middle mb-0">

                <thead class="table-primary">

                    <tr>

                        <th>ID</th>

                        <th>Name</th>

                        <th>Email</th>

                        <th>Phone</th>

                        <th>Department</th>

                        <th>Position</th>

                        <th>Joining Date</th>

                        <th>Status</th>

                        <th>Salary</th>

                        <th>Actions</th>

                    </tr>

                </thead>

                <tbody>

                    <% if(employees.length===0){ %>

                    <tr>

                        <td colspan="10" class="text-center p-5">

                            <h4>No Employees Available</h4>

                            <a href="/add" class="btn btn-primary mt-3">

                                Add First Employee

                            </a>

                        </td>

                    </tr>

                    <% } %>

                    <% employees.forEach(employee=>{ %>

                    <tr>

                        <td><%= employee.id %></td>

                        <td><strong><%= employee.name %></strong></td>

                        <td><%= employee.email %></td>

                        <td><%= employee.phone %></td>

                        <td><%= employee.department %></td>

                        <td><%= employee.position %></td>

                        <td><%= employee.joiningDate %></td>

                        <td>

                            <% if(employee.status==="Active"){ %>

                            <span class="badge bg-success">

                                Active

                            </span>

                            <% } else { %>

                            <span class="badge bg-warning text-dark">

                                On Leave

                            </span>

                            <% } %>

                        </td>

                        <td>

                            ₹<%= employee.salary %>

                        </td>

                        <td>

                            <a href="/edit/<%= employee.id %>" class="btn btn-warning btn-sm">

                                <i class="bi bi-pencil-square"></i>

                            </a>

                            <form action="/delete/<%= employee.id %>?_method=DELETE"
                                  method="POST"
                                  style="display:inline;">

                                <button
                                    class="btn btn-danger btn-sm"
                                    onclick="return confirm('Are you sure you want to delete this employee?')">

                                    <i class="bi bi-trash-fill"></i>

                                </button>

                            </form>

                        </td>

                    </tr>

                    <% }) %>

                </tbody>

            </table>

        </div>

    </div>

</div>

<footer class="footer mt-5">

    <h5>Employee Management System</h5>

    <p>

        Powered by Node.js • Express • AWS EC2 • CodePipeline

    </p>

</footer>

</body>

</html>
